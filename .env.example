# Apex Sniper local environment template
# Copy to `.env` and adjust for your machine.

# --- Runtime / performance ---
DATA_FETCH_WORKERS=8
SCHWAB_API_CONCURRENCY=2
APEX_SAFE_MODE=1
APEX_INDICATOR_CACHE_MAX_BYTES=3221225472

# --- Accuracy policy ---
APEX_BACKTEST_ACCURACY_MODE=warn
APEX_REQUIRE_PIT_UNIVERSE=1
APEX_BACKTEST_MIN_COVERAGE_RUSSELL=0.75

# --- Cache / refresh ---
APEX_BACKTEST_CACHE_FIRST=1
APEX_BACKTEST_FORCE_REFRESH_FOR_ACCURACY=1
APEX_BACKTEST_REFRESH_WHEN_CLOSED=0

# --- Optional PIT sources ---
# RUSSELL3000_PIT_DIR=data/russell3000_membership
# RUSSELL3000_PIT_MEMBERSHIP_CSV=

# IMPORTANT:
# - Do NOT put real API secrets in files that are committed.
# - Keep local auth tokens (e.g., data/schwab_tokens.json) out of git.

