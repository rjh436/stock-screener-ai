# Apex Sniper local environment template
# Copy to `.env` and adjust for your machine.

# --- Runtime / performance ---
DATA_FETCH_WORKERS=8
SCHWAB_API_CONCURRENCY=2
APEX_SAFE_MODE=1
APEX_INDICATOR_CACHE_MAX_BYTES=3221225472

# --- Accuracy policy ---
APEX_BACKTEST_ACCURACY_MODE=warn
APEX_REQUIRE_PIT_UNIVERSE=1
# Optional override (defaults are duration-aware in app.py)
# APEX_BACKTEST_MIN_COVERAGE_RUSSELL=0.55
# Optional strict/warn quality thresholds (defaults are duration-aware)
# APEX_BACKTEST_MIN_RECENT_COVERAGE_STRICT=0.55
# APEX_BACKTEST_MAX_INCOMPLETE_RATIO_STRICT=0.10
# APEX_BACKTEST_MAX_STALE_RATIO_STRICT=0.40
# APEX_BACKTEST_MIN_RECENT_COVERAGE_WARN=0.50
# APEX_BACKTEST_MAX_INCOMPLETE_RATIO_WARN=0.20
# APEX_BACKTEST_MAX_STALE_RATIO_WARN=0.55

# --- Cache / refresh ---
APEX_BACKTEST_CACHE_FIRST=1
APEX_BACKTEST_FORCE_REFRESH_FOR_ACCURACY=1
APEX_BACKTEST_REFRESH_WHEN_CLOSED=1
# In verified/strict mode, app defaults to fresh-first (cache-first off).
# Set to 1 only if you explicitly want strict mode to start cache-first.
# APEX_BACKTEST_STRICT_CACHE_FIRST=0
# Optional: increase strict refresh breadth for large universes.
# APEX_BACKTEST_REFRESH_MAX_SYMBOLS_STRICT=2600
# Strict mode lookback enforcement:
# 0 = allow shorter IPO histories (recommended for practical 5Y PIT runs)
# 1 = require full lookback coverage for each symbol
# APEX_BACKTEST_ENFORCE_FULL_LOOKBACK=0
# Show provisional metrics even if strict gate fails:
# 1 = show results with warning (not baseline-eligible)
# 0 = fully withhold blocked-run results
# APEX_BACKTEST_SHOW_BLOCKED_RESULTS=1

# --- Historical price fallback sources ---
# Keep this enabled so missing Schwab symbols can be backfilled.
DATA_ENABLE_FALLBACK_HISTORY=1
# Default provider order in loader.py
DATA_FALLBACK_PROVIDERS=yahoo,stooq
# Optional premium provider (if key is set, you can prepend it):
# DATA_FALLBACK_PROVIDERS=polygon,yahoo,stooq
# DATA_POLYGON_API_KEY=your_polygon_key
# Optional fallback tuning
# DATA_FALLBACK_TIMEOUT_SEC=8
# DATA_FALLBACK_MAX_WORKERS=8
# DATA_FALLBACK_MIN_BARS=40
# DATA_MISSING_RETRY_HOURS=6

# --- Optional PIT sources ---
# RUSSELL3000_PIT_DIR=data/russell3000_membership
# RUSSELL3000_PIT_MEMBERSHIP_CSV=

# IMPORTANT:
# - Do NOT put real API secrets in files that are committed.
# - Keep local auth tokens (e.g., data/schwab_tokens.json) out of git.
